# -----------------------------------------------------------------------------
#  Conexión a la base del SERVIDOR (devtristan.cloud)
#
#  Cópialo como `.env.produccion` y llena los datos. Ese archivo NO se sube al
#  repo (está en .gitignore), igual que `.env`.
#
#  Se usa así, sin tocar tu configuración local:
#      cd backend
#      node --env-file=.env.produccion scripts/dump-db.js
#
#  Los datos salen del `.env` que vive en el servidor, en
#  /var/www/tienda-hilos/backend/.env
# -----------------------------------------------------------------------------

NODE_ENV=production

# --- La base del servidor ---
DB_HOST=72.60.112.92
DB_PORT=3306
DB_USER=
DB_PASSWORD=
# El nombre de la base allá. NO tiene por qué llamarse "desarrollo".
DB_NAME=

# --- Estas dos no se usan para trabajar en la base, pero el backend las exige
#     al arrancar. Déjalas así: no se conectan a nada. ---
JWT_SECRET=solo-para-poder-leer-la-base-no-se-usa

# --- El asistente (IA) ---
# Sin IA_API_KEY el asistente arranca igual, pero contesta
# "no está configurado" en vez de fallar.
#
# Hoy usa GOOGLE GEMINI, que tiene capa gratuita. La llave se saca en
# aistudio.google.com/apikey. Se le habla por su endpoint compatible con
# OpenAI, así que cambiar de proveedor es cambiar estas dos líneas:
# para volver a DeepSeek serían https://api.deepseek.com y deepseek-chat.
IA_API_KEY=
IA_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Ojo: usa el alias `-latest`. Un nombre fijo de modelo lo retiran y entonces
# el asistente deja de contestar de un día para otro (pasa con 404).
IA_MODELO=gemini-flash-lite-latest
