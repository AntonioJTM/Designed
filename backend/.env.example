# -----------------------------------------------------------------------------
# Configuración del backend · Tienda de hilos
# Copia este archivo como .env y ajusta los valores. NO subas .env al repo.
# -----------------------------------------------------------------------------

# Servidor
NODE_ENV=development
PORT=3000

# Base de datos MySQL / MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=changeme
DB_NAME=tienda_hilos
DB_CONNECTION_LIMIT=10

# JWT
# Genera un secreto fuerte, p.ej.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=8h

# bcrypt
BCRYPT_ROUNDS=12

# CORS (orígenes permitidos, separados por coma). Usa * solo en desarrollo.
CORS_ORIGIN=http://localhost:4200
